# Fal API key (server-only, never expose as NEXT_PUBLIC_*)
FAL_KEY=

# FASHN API (https://app.fashn.ai/api → API keys) — server-only
# Used for Premium garment prep (FASHN Edit) before try-on, and optional Try-On Max.
# Requires AI_PREMIUM_GARMENT_EDIT_ENABLED=true and quality 2K in studio.
FASHN_API_KEY=
# AI_PREMIUM_GARMENT_EDIT_ENABLED=false
# Show Try-On Max A/B checkbox in studio step 3 (dev has it by default).
# NEXT_PUBLIC_TRYON_MAX_TOGGLE=1

# OpenAI (https://platform.openai.com/api-keys) — server-only, never NEXT_PUBLIC_*
OPENAI_API_KEY=
OPENAI_PROMPT_MODEL=gpt-5.5
# Pose-from-product (/api/ai/analyze-product-angles): vision model, then OPENAI_PROMPT_MODEL
OPENAI_VISION_MODEL=gpt-5.5
# Model generation (/api/ai/generate-model): GPT composes the Fal prompt when OPENAI_API_KEY is set.
# Set COMPOSE_MODEL_PROMPT_WITH_LLM=0 to use only the server template.
# COMPOSE_MODEL_PROMPT_WITH_LLM=1

# Paid AI budget guard. Keep false by default.
ALLOW_PAID_AI_RUNS=false
MAX_AI_TEST_SPEND_USD=5

# AI_MOCK_MODE=1 means demo mode without real Fal requests.
# Set AI_MOCK_MODE=0 and FAL_KEY=... only after explicit approval.
AI_MOCK_MODE=1

# Supabase (https://supabase.com/dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose as NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=

# Postgres direct connection (server-only)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DB_HOST=db.[PROJECT-REF].supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

# WhatsApp registration via Green API (server-only)
# Use GREEN_API_INSTANCE_ID + GREEN_API_TOKEN (not GREEN_API_ID_INSTANCE / GREEN_API_TOKEN_INSTANCE)
# Optional: instance host from the Green API console (e.g. https://7107.api.greenapi.com).
# If omitted, derived from the first 4 digits of GREEN_API_INSTANCE_ID.
GREEN_API_URL=
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
WHATSAPP_AUTH_FROM_PHONE=
WHATSAPP_AUTH_CODE_TTL_MINUTES=10
APP_SESSION_SECRET=

# For real local file uploads, files are uploaded server-side to Fal Storage.

# AI model generation uses fal-ai/nano-banana-pro in real mode.
# Fal calls are paid in real AI mode. Keep AI_MOCK_MODE=1 during development.

# Background removal uses fal-ai/bria/background/remove in real mode.
# Keep AI_MOCK_MODE=1 during development to avoid paid calls.

# Товарная карточка can use fal-ai/bria/product-shot in real mode.
# Keep AI_MOCK_MODE=1 unless explicitly testing paid generation.

NEXT_PUBLIC_APP_NAME="Vitrina AI Studio"

# Public canonical site URL for metadata, sitemap, robots, llms.txt.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Search engine verification placeholders.
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

# Analytics placeholders. Empty values disable scripts/events.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_YANDEX_METRIKA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# IndexNow is disabled by default.
INDEXNOW_KEY=
INDEXNOW_HOST=
INDEXNOW_ENABLED=false
